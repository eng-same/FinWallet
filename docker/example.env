# -----------------------------------------------------------------------------
# Docker Registry Configuration
# -----------------------------------------------------------------------------
# GitHub Container Registry URL and target repository name.
# Update the repository below to match your GitHub 'username/repo' namespace
DOCKER_REGISTRY=ghcr.io
DOCKER_REPOSITORY=your-github-username/finwallet
IMAGE_TAG=staging

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=finwallet_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=finwallet_db

# -----------------------------------------------------------------------------
# Message Broker Configuration (RabbitMQ)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=finwallet_rmq_user
RABBITMQ_DEFAULT_PASS=your_secure_rmq_password

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Generate a secure 256-bit key (e.g. using openssl rand -base64 32)
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry + Jaeger)
# -----------------------------------------------------------------------------
# Set to true to enable distributed tracing export to Jaeger.
# Defaults to true for local development; set to false in staging if not needed.
OBSERVABILITY_ENABLED=true
# Host port for the Jaeger UI (default: 16686)
JAEGER_UI_PORT=16686
# Host port for the Jaeger OTLP gRPC collector (default: 4317)
JAEGER_OTLP_GRPC_PORT=4317
